# REVORA Environment Template
# Copy to .env.local and fill in values. Never commit secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (optional — Demo Mode works without these)
# URL should be https://<project-ref>.supabase.co (no /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Database password from Project Settings → Database (needed to apply SQL migrations)
SUPABASE_DB_PASSWORD=
# Optional pooler region override (default ap-southeast-1)
# SUPABASE_DB_REGION=ap-southeast-1
# Or provide a full connection string instead:
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Razorpay TEST MODE only (optional — Demo Mode works without these)
# Server-only — NEVER prefix with NEXT_PUBLIC_
# Use rzp_test_ keys from the Razorpay Dashboard → Test Mode
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Provider (optional — deterministic fallback used when unset)
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
